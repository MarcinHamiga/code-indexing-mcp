Screen {
    layout: vertical;
    background: $surface;
    color: $text;
}

#header-bar { height: 2; padding: 0 1; background: $panel; }
#header-title { text-style: bold; }
#header-status { color: $text-muted; }
#project-bar { height: 3; padding: 0 1; }
#project-select { width: 1fr; min-width: 18; margin-right: 1; }
#mode-select { width: 19; margin-right: 1; }
#match-select { width: 17; margin-right: 1; }
#index-button { width: 12; min-width: 12; }
#query-bar { height: 3; padding: 0 1; }
#query-input { width: 1fr; }
#pane-switch { height: 1; padding: 0 1; }
#pane-switch Button { height: 1; min-width: 12; border: none; margin-right: 1; }

#main-container {
    layout: horizontal;
    height: 1fr;
    padding: 0 1;
}

#results-pane {
    width: 40%;
    height: 100%;
    border: solid $secondary;
    padding: 0;
    margin-right: 1;
}

#results-title {
    background: $panel;
    color: $text;
    padding: 0 1;
    text-style: bold;
    border-bottom: solid $secondary;
}

#results-list {
    height: 1fr;
}

#detail-pane {
    width: 60%;
    height: 100%;
    border: solid $secondary;
    padding: 0;
}

#detail-title {
    background: $panel;
    color: $text;
    padding: 0 1;
    text-style: bold;
    border-bottom: solid $secondary;
}

#detail-scroll {
    height: 1fr;
    padding: 0 1;
}

#detail-content {
    width: 100%;
}

#status-bar {
    height: 1;
    background: $panel;
    padding: 0 1;
    color: $text;
}

#status-bar.error {
    color: $error;
    text-style: bold;
}

Footer {
    dock: bottom;
}

.compact #results-pane, .compact #detail-pane { width: 1fr; margin-right: 0; }
#results-pane:focus-within, #detail-pane:focus-within { border: solid $accent; }
