Screen {
    layout: vertical;
    background: $surface;
    color: $text;
}

#header-bar { height: 2; padding: 0 1; background: $panel; }
#header-title { text-style: bold; }
#header-status { color: $text-muted; }
#project-bar { height: 3; padding: 0 1; }
#project-select { width: 1fr; min-width: 18; margin-right: 1; }
#mode-select { width: 22; margin-right: 1; }
#match-select { width: 17; margin-right: 1; }
#index-button { width: 14; min-width: 14; }
#query-bar { height: 3; padding: 0 1; }
#query-input { width: 1fr; }
#pane-switch { height: 1; padding: 0 1; }
#pane-switch Button { height: 1; min-width: 12; border: none; margin-right: 1; }

#main-container {
    layout: horizontal;
    height: 1fr;
    padding: 0 1;
}

#results-pane {
    width: 40%;
    height: 100%;
    border: solid $secondary;
    padding: 0;
    margin-right: 1;
}

#results-title {
    background: $panel;
    color: $text;
    padding: 0 1;
    text-style: bold;
    border-bottom: solid $secondary;
}

#results-list {
    height: 1fr;
}

#detail-pane {
    width: 60%;
    height: 100%;
    border: solid $secondary;
    padding: 0;
}

#detail-title {
    background: $panel;
    color: $text;
    padding: 0 1;
    text-style: bold;
    border-bottom: solid $secondary;
}

#detail-scroll {
    height: 1fr;
    padding: 0 1;
}

#detail-content {
    width: 100%;
}

#status-bar {
    height: 1;
    background: $panel;
    padding: 0 1;
    color: $text;
}

#status-bar.error {
    color: $error;
    text-style: bold;
}

Footer {
    dock: bottom;
}

.compact #results-pane, .compact #detail-pane { width: 1fr; margin-right: 0; }
#results-pane:focus-within, #detail-pane:focus-within { border: solid $accent; }

#detail-tabs { height: 2; }
#detail-tabs Tab { height: 1; padding: 0 1; }
#detail-list { height: 1fr; }
.has-entries #detail-scroll { height: auto; max-height: 5; }

#progress-bar { height: 1; padding: 0 1; color: $accent; }
#error-panel { height: auto; border-left: solid $error; margin: 0 1; }
#error-scroll { height: auto; max-height: 3; }
#error-content { height: auto; padding: 0 1; }
#error-actions { height: 1; }
#error-actions Button { height: 1; min-width: 10; border: none; }
#context-help { height: 1; padding: 0 1; color: $text-muted; }
HelpScreen { align: center middle; background: $background 70%; }
#help-dialog { width: 76; max-width: 95%; height: auto; max-height: 90%; border: solid $accent; padding: 1 2; background: $surface; }

#detail-title, #results-title { height: 1; width: 100%; border-bottom: none; }

#results-list, #detail-list { border: none; }
