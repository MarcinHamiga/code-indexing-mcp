# The extractor corpus is compared byte-for-byte against a committed snapshot of
# chunk offsets (tests/test_extractor_equivalence.py), so these files must check
# out identically on every platform. Without this, Windows checkouts get CRLF and
# every offset in the snapshot shifts by one byte per preceding line.
tests/fixtures/extractor_corpus/** text eol=lf

# The TypeScript tree is formatted by Biome, which writes LF. Without this a
# Windows checkout gets CRLF and `biome format --check` fails on every line of
# every file -- the same hazard the extractor corpus above guards against, for
# the same reason.
ts/** text eol=lf
