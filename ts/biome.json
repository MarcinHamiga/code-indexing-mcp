{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/node_modules", "!**/dist", "!**/results", "!**/test/fixtures/**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noParameterProperties": "error",
        "noEnum": "error",
        "noNamespace": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "bun:sqlite": "Bun-only APIs belong behind an adapter in src/runtime/.",
              "bun:ffi": "Bun-only APIs belong behind an adapter in src/runtime/.",
              "bun:jsc": "Bun-only APIs belong behind an adapter in src/runtime/."
            }
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    }
  },
  "overrides": [
    {
      "includes": ["**/src/runtime/**", "packages/spikes/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
