.worktrees/
# The serving environment, and the accelerator's own environment beside it.
# Both are build output; an untracked .venv-accel would also make the installer
# refuse to update the checkout it sits in.
.venv/
.venv-accel/
# Left behind by `code-indexing-mcp update`'s single-flight lock; if tracked as
# dirt it would make install.py refuse to update the checkout it sits in.
.update.lock
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

